NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streams?schema=public"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REQUEST_BODY_LIMIT="1mb"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-with-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-secret-access-key"
AWS_S3_BUCKET="replace-with-bucket-name"
UPLOAD_URL_EXPIRY=3600
